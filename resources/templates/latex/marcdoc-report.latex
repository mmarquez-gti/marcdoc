% MarcDoc sample LaTeX template (Pandoc template syntax), for LuaLaTeX.
% Title page from the front matter, running header and footer, and everything Pandoc emits for
% MarcDoc's Markdown: tables, images, code highlighting, footnotes, math, task lists, links.
\documentclass[11pt,a4paper$if(lang)$,$babel-lang$$endif$]{article}

\usepackage[a4paper,margin=2.5cm,headheight=14pt]{geometry}
% amssymb (task list boxes) must be loaded before unicode-math, as in Pandoc's template.
\usepackage{amsmath,amssymb}
\usepackage{unicode-math}
% Carlito (Linux) or Calibri (Windows, macOS with Office); otherwise LaTeX's Latin Modern.
\IfFontExistsTF{Carlito}{\setmainfont{Carlito}\setsansfont{Carlito}}{%
  \IfFontExistsTF{Calibri}{\setmainfont{Calibri}\setsansfont{Calibri}}{}}
\IfFontExistsTF{DejaVu Sans Mono}{\setmonofont{DejaVu Sans Mono}[Scale=0.85]}{}
$if(lang)$
\usepackage{babel}
$endif$

\usepackage{xcolor}
\definecolor{accent}{HTML}{1F4E79}
\usepackage{titlesec}
\titleformat{\section}{\Large\bfseries\color{accent}}{\thesection}{1em}{}
\titleformat{\subsection}{\large\bfseries\color{accent}}{\thesubsection}{1em}{}

\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\small $if(title)$$title$$endif$}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\usepackage{parskip}
\usepackage{longtable,booktabs,array}
\usepackage{calc}
\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\usepackage{soul}
\usepackage{footnotehyper}
\makesavenoteenv{longtable}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\setcounter{secnumdepth}{-\maxdimen}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
\usepackage{fancyvrb}
$if(csl-refs)$
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}
\newenvironment{CSLReferences}[2]
  {\setlength{\parindent}{0pt}\everypar{\setlength{\hangindent}{\cslhangindent}}\ignorespaces}
  {\par}
\newcommand{\CSLBlock}[1]{#1\hfill\break}
\newcommand{\CSLLeftMargin}[1]{\parbox[t]{\csllabelwidth}{#1}}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{#1}\break}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}
$endif$
$for(header-includes)$
$header-includes$
$endfor$
\usepackage[hidelinks]{hyperref}
\hypersetup{pdftitle={$title-meta$},pdfauthor={$author-meta$}}

\begin{document}

$if(title)$
\begin{titlepage}
  \centering
  \vspace*{0.3\textheight}
  {\Huge\bfseries\color{accent} $title$\par}
  $if(subtitle)$\vspace{1em}{\Large $subtitle$\par}$endif$
  \vspace{2em}
  {\large\itshape $for(author)$$author$$sep$ \and $endfor$\par}
  $if(date)$\vspace{1em}{\large $date$\par}$endif$
\end{titlepage}
$endif$

$body$

\end{document}
